locals {
  env          = "prod"
  account_name = "aws-delphi-prod"
  account_id   = "000000000000"
  aws_profile  = "aws-delphi-prod"
  landscape    = "delphi"

  route53_account_id   = "000000000000"
  dns_manager_role_arn = "arn:aws:iam::000000000000:role/role-EXAMPLE-root-ue1-dns_manager"

  # App-deploy role subjects. The github_oidc_role module adds the repo: prefix.
  # Use org/repo names in a published sample. Repositories that issue immutable
  # subjects keep the real owner and repository ids in the gitignored account.hcl.
  oidc_subjects = [
    "EXAMPLE_GITHUB_ORG/argus-api-lambda:*",
    "EXAMPLE_GITHUB_ORG/argus-front-end:*",
  ]

  # Full OIDC sub claims for the Terragrunt plan and apply roles, including repo:.
  # These are not passed through the app-deploy module, so do not omit the prefix.
  # Confirm the claim before the first apply. Immutable repositories use
  # repo:ORG@ORG_ID/aws-delphi@REPO_ID:environment:prod-plan.
  iac_plan_oidc_subject      = "repo:EXAMPLE_GITHUB_ORG/aws-delphi:environment:prod-plan"
  iac_apply_oidc_subject     = "repo:EXAMPLE_GITHUB_ORG/aws-delphi:environment:prod"
  iac_apply_job_workflow_ref = "EXAMPLE_GITHUB_ORG/aws-delphi/.github/workflows/terragrunt-apply.yml@refs/heads/main"
}
